# ============================================================
# MarketIQ Production Environment Configuration Template
# ============================================================
# Copy this file to .env on your production server and configure.
# NEVER commit the active production .env file to version control.

# Application Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Comma-separated list of allowed frontend origins)
# Example: CORS_ORIGINS=https://marketiq.vercel.app,https://yourdomain.com
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Optional API Secret Key for protecting administrative/paper endpoints
API_SECRET_KEY=generate_a_secure_random_hex_key_here

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_HISTORY_MESSAGES=10

# Database Configuration (Managed PostgreSQL recommended for production)
# Example: DATABASE_URL=postgresql://user:password@your-postgres-host:5432/marketiq_db
# For SQLite (single container persistent volume only): DATABASE_URL=sqlite:////data/paper_trading.db
DATABASE_URL=postgresql://user:password@localhost:5432/marketiq_db

# Market Data Settings
DATA_PROVIDER=YAHOO_FINANCE
DEFAULT_EXCHANGE=NSE
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15

# Paper Trading & Risk Controls (Defaults in INR)
PAPER_INITIAL_CAPITAL=100000.0
PAPER_DEFAULT_BROKERAGE_PCT=0.05
PAPER_DEFAULT_SLIPPAGE_PCT=0.02
PAPER_MAX_POSITION_SIZE_PCT=25.0
PAPER_MAX_ORDER_VALUE=50000.0
PAPER_DAILY_LOSS_LIMIT=5000.0
PAPER_MAX_OPEN_POSITIONS=5
