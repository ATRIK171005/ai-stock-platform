# ==========================================
# AI-Powered Stock Platform Environment Config
# ==========================================

# Application
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Provider Configuration (Auto prefers Groq if configured, else Gemini)
AI_PROVIDER=AUTO

# Groq API (High throughput, OpenAI-compatible JSON mode)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL (leave empty for same-origin proxy in production)
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./market_data.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/market_platform

# Market Data Settings
DATA_PROVIDER=YAHOO_FINANCE
DEFAULT_EXCHANGE=NSE

# Risk Limits (Paper Trading Defaults)
STARTING_BALANCE=100000
MAX_POSITION_SIZE_PERCENT=25
DAILY_LOSS_LIMIT=5000
DEFAULT_BROKERAGE_PERCENT=0.05
DEFAULT_SLIPPAGE_PERCENT=0.02
